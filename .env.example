# Copy to .env and fill in. Never commit .env.
# PayPal sandbox app keys: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Gemini API key: aistudio.google.com > Get API key
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-3.5-flash)
GEMINI_MODEL=
# Optional on your machine; set it on Render. Needed to press "Carry out" when set.
OWNER_PASSCODE=
# Optional: a different sandbox test card for npm run seed, if PayPal declines the default
# one (PAYER_CANNOT_PAY). Generate one at developer.paypal.com/tools/sandbox/card-testing/
SEED_CARD_NUMBER=
SEED_CARD_EXPIRY=
SEED_CARD_CVV=
